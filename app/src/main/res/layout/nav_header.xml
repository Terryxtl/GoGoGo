<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_header_height"
    android:background="@drawable/side_nav_bar"
    android:orientation="vertical"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:gravity="bottom">
    <!-- Background @drawable/side_nav_bar and theme overlay removed for M3 -->
    <!-- Consider using standard M3 surface colors for nav header background -->

    <ImageView
        android:id="@+id/user_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        app:srcCompat="@mipmap/ic_launcher_round" />
        <!-- Consider ShapeableImageView for rounded corners if desired -->

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/user_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nav_header_vertical_spacing"
        android:text="@string/nav_user_name"
        android:textSize="18sp"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/user_limit_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/nav_user_limit_info"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        app:drawableStartCompat="@drawable/ic_msg"
        android:drawablePadding="5dip"
        android:gravity="center_vertical"/>

</LinearLayout>
