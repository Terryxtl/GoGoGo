<resources>

    <!-- ThemeOverlay for Toolbar -->
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <!-- Ripple effect style -->
    <style name="RippleWhite" parent="Theme.Material3.DayNight">
        <item name="colorControlHighlight">#1F000000</item> <!-- Example M3 ripple for light theme -->
        <!-- For M3, ripple is generally handled by the components themselves when using M3 theme -->
    </style>

    <!-- Dialog animation -->
    <style name="DialogAnimFadeInFadeOut" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/anim_fade_in</item>
        <item name="android:windowExitAnimation">@anim/anim_fade_out</item>
    </style>

    <!-- Button Style using M3 -->
    <style name="AppTheme.Button" parent="Widget.Material3.Button">
        <!-- You can further customize M3 buttons here if needed -->
        <!-- For example, to use a specific M3 button style: -->
        <!-- <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.Button.TextButton</item> -->
    </style>

</resources>
